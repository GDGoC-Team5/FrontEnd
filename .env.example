# 이 파일을 복사해서 .env.local 로 이름을 바꿔 쓰세요. (.env.local은 깃에 안 올라가요)

# true  → 백엔드 없이 가짜 데이터로 화면이 돌아가요 (데모 계정: demo@gdgoc.com / demo1234!)
# false → 진짜 백엔드 API를 호출해요
NEXT_PUBLIC_USE_MOCK=true

# 진짜 백엔드 주소. NEXT_PUBLIC_USE_MOCK=false 일 때만 쓰여요.
# 로컬에서 스프링을 8080으로 켰다면 그대로 두면 돼요.
BACKEND_URL=http://localhost:8080
